<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <AssemblyName>LedControl</AssemblyName>
    <Product>OpenWrt LED Control</Product>
    <AssemblyTitle>OpenWrt LED Control</AssemblyTitle>
    <Description>Консольное приложение для управления LED-индикаторами роутера на OpenWrt по SSH</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
